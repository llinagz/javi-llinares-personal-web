{
  "name": "javi-llinares-personal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "node -e \"for (const d of ['.astro', 'node_modules/.astro']) require('fs').rmSync(d + '/data-store.json', { force: true })\"",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "nuevo": "node scripts/nuevo.mjs",
    "bot:webhook": "node scripts/telegram-webhook.mjs",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/literata": "^5.3.0",
    "@vercel/blob": "^2.8.2",
    "astro": "^5.18.2",
    "exifr": "^7.1.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "cross-env": "^10.1.0"
  }
}
