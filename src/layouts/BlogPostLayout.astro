---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/ui/Badge.astro";
import { formatDate } from "@/lib/content";
import type { BlogPost } from "@/lib/content";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<BaseLayout title={`${post.data.title} | Javi Llinares`} description={post.data.excerpt} image={post.data.image} type="article">
  <article>
    <header class="matrix-page page-hero">
      <div class="container relative">
        <a class="terminal-link" href="/blog">← Blog</a>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Badge tone="soft">{post.data.category}</Badge>
          <span class="font-mono text-sm text-terminal-text/[0.62]">{formatDate(post.data.date)}</span>
          <span class="font-mono text-sm text-terminal-text/[0.34]">/</span>
          <span class="font-mono text-sm text-terminal-text/[0.62]">{post.data.readingTime}</span>
        </div>
        <h1 class="mt-6 max-w-4xl font-serif text-4xl font-semibold leading-tight tracking-tight text-paper md:text-6xl">
          {post.data.title}
        </h1>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-terminal-text/[0.72]">{post.data.excerpt}</p>
        {
          post.data.image && (
            <div class="paper-panel mt-10 overflow-hidden rounded-[2rem]">
              <Image
                class="h-auto w-full object-cover"
                src={post.data.image}
                alt={`Imagen editorial del artículo ${post.data.title}`}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1240px) 1200px, 100vw"
                loading="eager"
              />
            </div>
          )
        }
      </div>
    </header>

    <section class="paper-band py-14 md:py-20">
      <div class="container">
        <div class="prose-content prose-shell mx-auto">
          <slot />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
