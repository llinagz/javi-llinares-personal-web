---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/ui/Badge.astro";
import { formatDate } from "@/lib/content";
import type { BlogPost } from "@/lib/content";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<BaseLayout title={`${post.data.title} | Javi Llinares`} description={post.data.excerpt}>
  <article class="container section">
    <div class="mx-auto max-w-3xl">
      <a class="text-sm font-semibold text-primary hover:underline" href="/blog">← Blog</a>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Badge tone="soft">{post.data.category}</Badge>
        <span class="text-sm text-muted">{formatDate(post.data.date)}</span>
        <span class="text-sm text-muted">·</span>
        <span class="text-sm text-muted">{post.data.readingTime}</span>
      </div>
      <h1 class="mt-6 font-serif text-4xl font-semibold leading-tight tracking-tight text-text md:text-6xl">
        {post.data.title}
      </h1>
      <p class="mt-6 text-xl leading-8 text-muted">{post.data.excerpt}</p>
      {
        post.data.image && (
          <div class="mt-10 overflow-hidden rounded-[2rem] border border-border bg-primary-soft">
            <img class="h-auto w-full object-cover" src={post.data.image} alt={`Imagen editorial del artículo ${post.data.title}`} />
          </div>
        )
      }
    </div>

    <div class="prose-content mx-auto mt-14">
      <slot />
    </div>
  </article>
</BaseLayout>
