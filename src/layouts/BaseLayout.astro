---
import { getImage } from "astro:assets";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string; // string: URL remota (foto en Blob), que Astro descarga en el build
  type?: "website" | "article";
}

const {
  title = "Javi Llinares | Ideas, código y proyectos",
  description = "Web personal de Javi Llinares: software, pensamiento, cultura, lectura, tecnología y proyectos construidos con intención.",
  image,
  type = "website"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = image ? await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg" }) : undefined;
const socialImageUrl = socialImage ? new URL(socialImage.src, canonical) : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800,900&display=swap" />
    <link rel="alternate" type="application/rss+xml" title="Javi Llinares | Jardín" href="/rss.xml" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Javi Llinares" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main class="w-full max-w-full overflow-x-hidden">
      <slot />
    </main>
    <Footer />
  </body>
</html>
