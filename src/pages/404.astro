---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada | Javi Llinares" description="La página que buscas no existe o ha cambiado de lugar.">
  <section class="matrix-page page-hero">
    <div class="container relative">
      <div class="section-heading">
        <p class="terminal-label">./404</p>
        <h1 class="display-type mt-4 text-5xl font-black leading-[0.92] text-paper md:text-7xl">
          Esta ruta no existe.
        </h1>
        <p class="mt-6 text-lg leading-8 text-terminal-text/[0.72]">
          Puede que el enlace haya cambiado o que nunca haya existido. Vuelve al inicio o explora el archivo.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a class="terminal-link" href="/">← Inicio</a>
          <a class="terminal-link" href="/jardin">Jardín →</a>
          <a class="terminal-link" href="/projects">Proyectos →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
