---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, isPublished, photoAlt, type Photo } from "@/lib/content";

export async function getStaticPaths() {
  const photos = await getCollection("carrete", isPublished);

  return photos.map((photo) => ({
    params: { slug: photo.data.slug },
    props: { photo }
  }));
}

const { photo } = Astro.props as { photo: Photo };
const { data } = photo;
const trip = data.trip ? await getEntry(data.trip) : undefined;
const technical = [data.camera, data.focalLength, data.aperture, data.shutterSpeed, data.iso && `ISO ${data.iso}`].filter(Boolean);
---

<BaseLayout title={`${data.title} | Carrete | Javi Llinares`} description={data.caption ?? `${data.title}, fotografía de Javi Llinares.`} image={data.image}>
  <section class="matrix-page page-hero">
    <div class="container relative">
      <a class="terminal-link" href="/carrete">← Carrete</a>
      <h1 class="mt-8 max-w-4xl font-serif text-4xl font-semibold leading-tight tracking-tight text-paper md:text-6xl">
        {data.title}
      </h1>
      <p class="mt-5 font-mono text-sm text-terminal-text/[0.62]">
        {[data.location, formatDate(data.date)].filter(Boolean).join(" · ")}
      </p>
    </div>
  </section>

  <section class="paper-band py-14 md:py-20">
    <div class="container">
      <figure class="mx-auto max-w-5xl">
        <div class="paper-panel overflow-hidden rounded-[1.5rem]">
          <Image
            class="h-auto w-full"
            src={data.image}
            alt={photoAlt(photo)}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1240px) 1100px, 100vw"
            loading="eager"
          />
        </div>
        {data.caption && <figcaption class="editorial-serif mt-6 text-2xl leading-snug text-ink">{data.caption}</figcaption>}
        {technical.length > 0 && <p class="mt-4 font-mono text-xs text-muted">{technical.join(" · ")}</p>}
        {
          trip && (
            <p class="mt-6 text-sm font-semibold text-primary">
              <a href={`/carrete/viajes/${trip.data.slug}`}>Parte del viaje: {trip.data.title} →</a>
            </p>
          )
        }
      </figure>
    </div>
  </section>
</BaseLayout>
