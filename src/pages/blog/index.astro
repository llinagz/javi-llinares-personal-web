---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import { formatDate, sortByDateDesc } from "@/lib/content";

const posts = sortByDateDesc(await getCollection("blog", ({ data }) => !data.draft));
---

<BaseLayout title="Blog | Javi Llinares" description="Artículos de Javi Llinares sobre programación, producto, lectura, cultura digital y pensamiento.">
  <section class="container section">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Blog</p>
      <h1 class="mt-4 font-serif text-4xl font-semibold tracking-tight text-text md:text-6xl">
        Artículos, ensayos y notas de trabajo.
      </h1>
      <p class="mt-6 text-lg leading-8 text-muted">
        Un archivo vivo para escribir sobre lo que voy aprendiendo: código, producto,
        lectura, cultura digital y algunas preguntas que se resisten a quedar cerradas.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <Card href={`/blog/${post.data.slug}`}>
            <div class="flex items-center justify-between gap-3">
              <Badge tone="soft">{post.data.category}</Badge>
              <span class="text-xs text-muted">{post.data.readingTime}</span>
            </div>
            <h2 class="mt-5 text-xl font-semibold leading-snug text-text group-hover:text-primary">
              {post.data.title}
            </h2>
            <p class="mt-3 text-sm leading-6 text-muted">{post.data.excerpt}</p>
            <p class="mt-6 text-sm text-muted">{formatDate(post.data.date)}</p>
            <p class="mt-4 text-sm font-semibold text-primary">Leer artículo →</p>
          </Card>
        ))
      }
    </div>
  </section>
</BaseLayout>
