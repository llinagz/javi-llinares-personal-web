---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";

const principles = [
  {
    title: "Comunicación clara",
    text: "Antes de diseñar, ordenamos qué quieres contar, a quién se lo cuentas y qué necesita entender esa persona."
  },
  {
    title: "Diseño con identidad",
    text: "Trabajo la parte visual para que tu web tenga presencia propia sin parecer una plantilla genérica."
  },
  {
    title: "Rendimiento y responsive",
    text: "La web debe cargar rápido, leerse bien y funcionar con solvencia en móvil, tablet y escritorio."
  },
  {
    title: "Autogestión posible",
    text: "Si necesitas editar contenidos sin tocar código, WordPress puede ser una buena opción dentro del proyecto."
  }
];

const process = [
  "Escuchar el proyecto y detectar qué necesita realmente la web.",
  "Ordenar contenidos, mensajes principales y estructura de navegación.",
  "Diseñar una propuesta visual coherente con tu identidad y tu público.",
  "Construir la web cuidando rendimiento, accesibilidad básica y mantenimiento.",
  "Publicar, revisar contigo los detalles y acompañarte en los primeros pasos."
];

const cases = [
  {
    name: "Marina Melia",
    field: "Psicología",
    text: "Una presencia profesional cercana, centrada en generar confianza y explicar servicios con calma.",
    url: "https://www.marinamelia.com"
  },
  {
    name: "Vanenbikke",
    field: "Mensajería en bicicleta",
    text: "Una web para explicar un servicio urbano, cercano y práctico con una identidad reconocible.",
    url: "https://www.vanenbikke.com"
  },
  {
    name: "Innova Idiomas",
    field: "Cursos online",
    text: "Web orientada a visibilidad, venta de cursos y organización de una oferta formativa digital.",
    url: "https://innovaidiomas.com"
  }
];

const faqs = [
  {
    question: "¿Cuánto tarda una web?",
    answer: "Depende del alcance, pero una web sencilla suele moverse alrededor de dos semanas de trabajo real. Si hay tienda, integraciones o mucho contenido, conviene reservar más margen."
  },
  {
    question: "¿Qué pasa si no tengo marca definida?",
    answer: "No pasa nada. Podemos empezar por una dirección visual mínima: tono, colores, tipografía, referencias y una pequeña guía para que la web tenga personalidad sin inventar una marca enorme."
  },
  {
    question: "¿Tiene que ser WordPress?",
    answer: "No necesariamente. WordPress encaja bien cuando quieres autogestionar contenidos de forma sencilla. Si el proyecto pide una web más estática, rápida y editorial, puedo plantear otras opciones."
  },
  {
    question: "¿Cómo trabajaremos juntos?",
    answer: "Principalmente por email, con mensajes claros, revisiones concretas y decisiones documentadas. La idea es que siempre sepas qué estamos haciendo y por qué."
  }
];
---

<BaseLayout
  title="Diseño web con criterio | Javi Llinares"
  description="Diseño y desarrollo de webs rápidas, cuidadas y mantenibles para profesionales, pymes y proyectos personales."
>
  <section class="noise-field relative overflow-hidden pt-28 md:pt-36">
    <div class="absolute inset-x-0 top-0 h-[44rem] bg-[radial-gradient(circle_at_78%_18%,rgba(22,82,78,0.22),transparent_28rem),radial-gradient(circle_at_24%_22%,rgba(181,93,56,0.16),transparent_24rem)]"></div>
    <div class="container relative grid gap-10 pb-16 md:pb-20 lg:grid-cols-[1.06fr_0.74fr] lg:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Diseño web</p>
        <h1 class="mt-5 display-type max-w-5xl text-[clamp(3.2rem,7vw,6.7rem)] font-black leading-[0.9] text-text">
          Diseño webs con calma, criterio y oficio técnico.
        </h1>
        <p class="mt-8 max-w-3xl text-xl leading-9 text-muted md:text-2xl">
          Ayudo a profesionales, pymes y proyectos personales a tener una presencia digital clara,
          rápida y humana. Una web que explique bien lo que haces y no te obligue a pelearte con la tecnología.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <Button href="mailto:hola@javillinares.com">Cuéntame tu proyecto</Button>
          <Button href="#proceso" variant="secondary">Ver el proceso</Button>
        </div>
      </div>

      <aside class="relative overflow-hidden rounded-[2.5rem] border border-white/40 bg-[#081917] p-7 text-white shadow-[0_36px_100px_rgba(8,25,23,0.22)] md:p-9">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_18%,rgba(181,93,56,0.35),transparent_18rem),radial-gradient(circle_at_90%_4%,rgba(22,82,78,0.62),transparent_20rem)]"></div>
        <div class="relative">
          <p class="editorial-serif text-3xl leading-tight md:text-4xl">
            Una buena web no empieza por una plantilla. Empieza por entender qué merece ser dicho.
          </p>
          <div class="mt-10 grid gap-3 text-sm text-white/74">
            <span class="rounded-2xl border border-white/15 bg-white/8 px-4 py-3">Estructura de contenidos</span>
            <span class="rounded-2xl border border-white/15 bg-white/8 px-4 py-3">Diseño visual y responsive</span>
            <span class="rounded-2xl border border-white/15 bg-white/8 px-4 py-3">Publicación y acompañamiento</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
      <div>
        <h2 class="display-type text-4xl font-black leading-[0.96] text-text md:text-6xl">
          Presencia digital sin ruido.
        </h2>
        <p class="mt-6 max-w-md text-lg leading-8 text-muted">
          Recupero lo mejor de aquella primera landing: cercanía, comunicación y ganas de cuidar el proyecto.
          Lo actualizo con una mirada más madura sobre contenido, rendimiento y mantenimiento.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {
          principles.map((item) => (
            <article class="rounded-[2rem] border border-border bg-surface p-7 shadow-quiet">
              <h3 class="text-xl font-semibold leading-snug text-text">{item.title}</h3>
              <p class="mt-4 text-sm leading-6 text-muted">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="proceso" class="bg-[#f8f1e3] py-16 md:py-20 lg:py-24">
    <div class="container grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <Badge tone="soft">Proceso</Badge>
        <h2 class="mt-5 display-type text-4xl font-black leading-[0.96] text-text md:text-6xl">
          Construir primero el sentido, después la pantalla.
        </h2>
      </div>

      <ol class="grid gap-4">
        {
          process.map((step, index) => (
            <li class="grid gap-4 rounded-[1.75rem] border border-primary/10 bg-background p-6 md:grid-cols-[4rem_1fr] md:items-center">
              <span class="display-type text-4xl font-black leading-none text-primary/45">
                {String(index + 1).padStart(2, "0")}
              </span>
              <p class="text-base leading-7 text-muted">{step}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">Algunos trabajos</p>
          <h2 class="mt-4 display-type text-4xl font-black leading-[0.96] text-text md:text-6xl">
            Proyectos donde la web tenía que explicar, acompañar y convencer.
          </h2>
        </div>
        <p class="max-w-2xl text-lg leading-8 text-muted">
          No busco enseñar una vitrina infinita. Prefiero mostrar trabajos que representan distintas
          necesidades: confianza profesional, estructura institucional y venta de formación online.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          cases.map((project) => (
            <a
              class="group flex min-h-[280px] flex-col justify-between rounded-[2rem] border border-border bg-surface p-7 shadow-quiet transition duration-200 hover:-translate-y-1 hover:border-primary/35"
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div>
                <Badge tone="soft">{project.field}</Badge>
                <h3 class="mt-5 display-type text-3xl font-black leading-none text-text group-hover:text-primary">
                  {project.name}
                </h3>
                <p class="mt-5 text-sm leading-6 text-muted">{project.text}</p>
              </div>
              <p class="mt-8 text-sm font-semibold text-primary">Ver proyecto</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-[#f8f1e3] py-16 md:py-20 lg:py-24">
    <div class="container grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 class="display-type text-4xl font-black leading-[0.96] text-text md:text-6xl">
          Dudas razonables antes de empezar.
        </h2>
        <p class="mt-6 max-w-md text-lg leading-8 text-muted">
          Un proyecto web funciona mejor cuando las expectativas están claras desde el principio.
        </p>
      </div>

      <div class="grid gap-4">
        {
          faqs.map((item) => (
            <article class="rounded-[1.75rem] border border-primary/10 bg-background p-6">
              <h3 class="text-lg font-semibold text-text">{item.question}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{item.answer}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="relative overflow-hidden rounded-[3rem] border border-white/30 bg-[#081917] p-8 text-white shadow-[0_36px_100px_rgba(8,25,23,0.22)] md:p-12">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(181,93,56,0.32),transparent_22rem),radial-gradient(circle_at_90%_0%,rgba(22,82,78,0.58),transparent_24rem)]"></div>
        <div class="relative grid gap-10 lg:grid-cols-[1fr_360px] lg:items-end">
          <div>
            <h2 class="display-type text-5xl font-black leading-[0.92] md:text-7xl">
              Si tu proyecto necesita una web, podemos pensarlo juntos.
            </h2>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-white/72">
              Escríbeme con una idea inicial, aunque esté desordenada. La primera parte del trabajo
              será precisamente darle forma.
            </p>
          </div>

          <div class="rounded-[1.75rem] bg-white p-6 shadow-quiet md:p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
              Empezar una conversación
            </p>
            <p class="mt-4 text-base leading-7 text-text">
              Cuéntame qué haces, qué necesitas que la web consiga y en qué punto estás ahora.
            </p>
            <a
              class="mt-6 inline-flex items-center justify-center rounded-2xl bg-primary px-5 py-3 text-sm font-bold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-primary-dark"
              href="mailto:hola@javillinares.com"
            >
              Cuéntame tu proyecto
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
