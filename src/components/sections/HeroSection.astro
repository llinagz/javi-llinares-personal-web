---
import Button from "@/components/ui/Button.astro";
---

<section class="noise-field relative overflow-hidden pt-28 md:pt-36">
  <div class="absolute inset-x-0 top-0 h-[48rem] bg-[radial-gradient(circle_at_78%_18%,rgba(22,82,78,0.28),transparent_28rem),radial-gradient(circle_at_24%_22%,rgba(181,93,56,0.22),transparent_24rem)]"></div>
  <div class="container relative grid items-end gap-12 pb-16 md:pb-20 lg:grid-cols-[1fr_0.68fr]">
    <div class="max-w-6xl" data-reveal>
      <h1 class="display-type max-w-6xl text-[clamp(3.4rem,7vw,6.8rem)] font-black leading-[0.9] text-text">
        Pensar software
        <span
          class="mx-2 inline-block h-12 w-28 rounded-full bg-cover bg-center align-middle grayscale contrast-125 md:h-16 md:w-40"
          style="background-image: url('https://picsum.photos/seed/mountain-notes/420/180')"
          aria-hidden="true"
        ></span>
        como quien aprende a vivir.
      </h1>
      <p class="mt-8 max-w-3xl text-xl leading-9 text-muted md:text-2xl">
        Una casa editorial para código, lectura, producto y esas preguntas lentas que no caben
        en un sprint pero terminan cambiando la forma de construir.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/blog">Leer el blog</Button>
        <Button href="/projects" variant="secondary">Explorar proyectos</Button>
      </div>
    </div>

    <div class="group relative min-h-[520px] overflow-hidden rounded-[2.5rem] border border-white/40 bg-[#081917] shadow-[0_36px_100px_rgba(8,25,23,0.22)]" data-reveal>
      <img
        class="h-full min-h-[520px] w-full object-cover opacity-85 grayscale contrast-125 transition-transform duration-700 ease-out group-hover:scale-105"
        src="https://picsum.photos/seed/editorial-code-cabin/1200/1500"
        alt="Paisaje editorial abstracto para representar tecnología y vida contemplativa"
      />
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,transparent,rgba(8,25,23,0.76)),linear-gradient(180deg,transparent,rgba(8,25,23,0.82))]"></div>
      <div class="absolute bottom-0 left-0 right-0 p-7 text-white md:p-9">
        <p class="editorial-serif text-3xl leading-tight">
          Claridad técnica con temperatura humana.
        </p>
        <div class="mt-8 grid grid-cols-2 border-t border-white/25 pt-5 text-sm text-white/76">
          <span>Astro estático</span>
          <span class="text-right">Ensayo personal</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script is:inline>
  window.addEventListener("load", () => {
    if (!window.gsap || !window.ScrollTrigger || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    gsap.registerPlugin(ScrollTrigger);
    gsap.from("[data-reveal]", {
      y: 38,
      opacity: 0,
      duration: 0.9,
      ease: "power3.out",
      stagger: 0.12
    });
  });
</script>
