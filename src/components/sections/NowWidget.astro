---
import { render } from "astro:content";
import { formatDate, nowRows, type Now, type Trip } from "@/lib/content";

interface Props {
  now?: Now;
  trip?: Trip;
  class?: string;
}

const { now, trip, class: customClass = "" } = Astro.props;

const rows = nowRows(now);

const NoteContent = now?.body?.trim() ? (await render(now)).Content : undefined;
---

{
  (rows.length > 0 || trip) && (
    <section class:list={["terminal-shell rounded-[1.75rem]", customClass]} aria-labelledby="now-title" data-reveal style="--reveal-index:1">
      <div class="terminal-topbar relative">
        <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
        <span id="now-title">ahora.md</span>
      </div>

      <div class="relative p-6 md:p-7">
        <dl class="grid gap-5">
          {
            rows.map((row) => (
              <div>
                <dt class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-clay-light">{row.label}</dt>
                <dd class="mt-1 text-base leading-7 text-terminal-text">{row.items.join(" · ")}</dd>
              </div>
            ))
          }
          {
            trip && (
              <div>
                <dt class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-clay-light">último viaje</dt>
                <dd class="mt-1 text-base leading-7 text-terminal-text">
                  <a class="underline decoration-terminal-text/[0.4] underline-offset-4 transition hover:decoration-terminal-text" href={`/carrete/viajes/${trip.data.slug}`}>
                    {trip.data.place}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
        {
          NoteContent && (
            <div class="editorial-serif mt-6 border-t border-paper/15 pt-5 text-lg leading-7 text-terminal-text/[0.82]">
              <NoteContent />
            </div>
          )
        }
        {now && <p class="mt-6 font-mono text-xs text-terminal-text/[0.66]">actualizado el {formatDate(now.data.updated)}</p>}
      </div>
    </section>
  )
}
