---
import { Image } from "astro:assets";
import Badge from "@/components/ui/Badge.astro";
import {
  excerpt,
  formatDate,
  gardenStages,
  gardenTypes,
  lastTended,
  readingTime,
  sortByTendedDesc,
  type GardenEntry
} from "@/lib/content";

interface Props {
  entries: GardenEntry[];
}

const entries = sortByTendedDesc(Astro.props.entries).slice(0, 3);
const [first] = entries;
---

<section class="matrix-section section">
  <div class="container relative">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="terminal-label">./jardin</p>
        <h2 class="display-type mt-4 max-w-4xl text-5xl font-black leading-[0.94] text-paper md:text-7xl">
          Un jardín de ideas en distintas estaciones.
        </h2>
      </div>
      <a class="rounded-xl border border-white/20 px-5 py-3 font-mono text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-white hover:text-ink" href="/jardin">Ver todo el jardín</a>
    </div>

    <div class="mt-14 grid auto-rows-[minmax(220px,auto)] grid-flow-dense gap-4 md:grid-cols-4 md:grid-rows-2">
      {
        first && (
          <a class="group terminal-shell rounded-[1.5rem] p-0 md:col-span-2 md:row-span-2" href={`/jardin/${first.data.slug}`}>
            {
              first.data.image && (
                <Image
                  class="absolute inset-0 h-full w-full object-cover opacity-[0.18] grayscale transition-transform duration-700 ease-out group-hover:scale-105"
                  src={first.data.image}
                  alt=""
                  aria-hidden="true"
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                />
              )
            }
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,19,17,0.94)_0%,rgba(6,19,17,0.9)_42%,rgba(6,19,17,0.98)_100%)]"></div>
            <div class="terminal-topbar relative">
              <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
              <span>{first.data.slug}.md</span>
            </div>
            <div class="relative flex min-h-[420px] flex-col justify-between p-7">
              <div class="flex items-center justify-between gap-3">
                <Badge tone="soft">{gardenTypes[first.data.type]}</Badge>
                <span class="font-mono text-xs text-white/58">
                  {gardenStages[first.data.stage].icon} {gardenStages[first.data.stage].label}
                </span>
              </div>
              <div>
                <p class="terminal-command mb-4">read featured</p>
                <h3 class="display-type text-4xl font-black leading-[0.95] text-paper md:text-6xl">
                  {first.data.title}
                </h3>
                <p class="mt-5 max-w-xl text-base leading-7 text-white/68">{excerpt(first)}</p>
                <p class="mt-7 font-mono text-sm font-bold text-clay-light">Leer entrada</p>
              </div>
            </div>
          </a>
        )
      }
      {
        entries.slice(1, 3).map((entry) => (
          <a class="paper-panel group block h-full overflow-hidden rounded-[1.5rem] p-6 transition duration-500 hover:-translate-y-1 hover:border-clay-light/40" href={`/jardin/${entry.data.slug}`}>
            <div class="flex items-center justify-between gap-3">
              <Badge tone="soft">{gardenTypes[entry.data.type]}</Badge>
              <span class="font-mono text-xs text-muted">
                {gardenStages[entry.data.stage].icon} {gardenStages[entry.data.stage].label}
              </span>
            </div>
            <p class="mt-5 font-mono text-sm leading-6 text-muted">$ open {entry.data.slug}.md</p>
            <h3 class="mt-4 text-xl font-semibold leading-snug text-ink group-hover:text-primary">
              {entry.data.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-muted">{excerpt(entry)}</p>
            <p class="mt-6 font-mono text-xs text-muted">{formatDate(lastTended(entry))} · {readingTime(entry.body)}</p>
            <p class="mt-4 text-sm font-semibold text-primary">Leer entrada</p>
          </a>
        ))
      }
      <a class="paper-panel group overflow-hidden rounded-[1.5rem] bg-primary-soft p-7 transition duration-500 hover:-translate-y-1 md:col-span-2" href="/about">
        <p class="font-mono text-sm leading-6 text-muted">$ cat about/mirada.txt</p>
        <p class="editorial-serif text-3xl leading-tight">
          La web no promete productividad infinita: busca una forma más atenta de pensar y construir.
        </p>
        <p class="mt-8 text-sm font-bold text-primary">Leer la mirada completa</p>
      </a>
    </div>
  </div>
</section>
