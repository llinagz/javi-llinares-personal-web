---
import { gardenStages, gardenTypes, type GardenEntry } from "@/lib/content";

interface Props {
  entries: GardenEntry[];
  class?: string;
}

const { entries, class: customClass = "" } = Astro.props;
---

{
  entries.length > 0 && (
    <section class={customClass} aria-labelledby="start-here-title">
      <h2 id="start-here-title" class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-clay-light">Para empezar</h2>
      <ul class="mt-4 grid gap-x-8 md:grid-cols-3">
        {entries.map((entry) => (
          <li class="border-t border-terminal-text/[0.12] py-4">
            <a class="group block" href={`/jardin/${entry.data.slug}`}>
              <p class="font-mono text-xs text-terminal-text/[0.6]">
                {gardenTypes[entry.data.type].toLowerCase()} · {gardenStages[entry.data.stage].icon} {gardenStages[entry.data.stage].label}
              </p>
              <h3 class="editorial-serif mt-2 text-xl leading-snug text-terminal-text transition-colors group-hover:text-clay-light">
                {entry.data.title}
              </h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
