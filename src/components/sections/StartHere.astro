---
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import { excerpt, gardenStages, gardenTypes, type GardenEntry } from "@/lib/content";

interface Props {
  entries: GardenEntry[];
  class?: string;
}

const { entries, class: customClass = "" } = Astro.props;
---

{
  entries.length > 0 && (
    <section class={customClass} aria-labelledby="start-here-title">
      <h2 id="start-here-title" class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-primary">Para empezar</h2>
      <div class="mt-5 grid gap-5 md:grid-cols-3">
        {entries.map((entry) => (
          <Card href={`/jardin/${entry.data.slug}`}>
            <div class="flex items-center justify-between gap-3">
              <Badge tone="soft">{gardenTypes[entry.data.type]}</Badge>
              <span class="font-mono text-xs text-muted">
                {gardenStages[entry.data.stage].icon} {gardenStages[entry.data.stage].label}
              </span>
            </div>
            <h3 class="mt-5 text-xl font-semibold leading-snug text-text group-hover:text-primary">{entry.data.title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{excerpt(entry)}</p>
          </Card>
        ))}
      </div>
    </section>
  )
}
