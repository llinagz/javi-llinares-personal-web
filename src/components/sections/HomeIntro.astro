---
interface Props {
  class?: string;
}

const { class: customClass = "" } = Astro.props;
---

<div class:list={["min-w-0", customClass]} data-reveal style="--reveal-index:0">
  <p class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-clay-light">~/javi</p>
  <h1 class="editorial-serif mt-3 text-[clamp(1.9rem,4vw,2.6rem)] font-normal leading-tight text-terminal-text">
    Jardín digital de Javi Llinares
  </h1>
  <p class="mt-3 max-w-2xl text-base leading-7 text-terminal-text/[0.72]">
    Código, lectura, producto y esas preguntas lentas que no caben en un sprint.
  </p>
</div>
