---
import Button from "@/components/ui/Button.astro";

interface Props {
  class?: string;
}

const { class: customClass = "" } = Astro.props;
---

<div class:list={["min-w-0 py-2 md:py-6", customClass]} data-reveal style="--reveal-index:0">
  <p class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-primary">~/javi</p>
  <h1 class="display-type mt-5 text-[clamp(2.5rem,7vw,5.25rem)] font-black leading-[0.94] text-text">
    Pensar software como quien aprende a vivir.
  </h1>
  <p class="editorial-serif mt-7 max-w-2xl text-xl leading-9 text-prose md:text-2xl">
    Un rincón para código, lectura, producto y esas preguntas lentas que no caben en un sprint pero
    terminan cambiando la forma de construir.
  </p>
  <div class="mt-8 flex flex-wrap gap-4">
    <Button href="/jardin">Entrar al jardín</Button>
    <Button href="/about" variant="secondary">Sobre mí</Button>
  </div>
</div>
