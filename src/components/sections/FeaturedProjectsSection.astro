---
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import { sortByDateDesc, type Project } from "@/lib/content";

interface Props {
  projects: Project[];
}

const projects = sortByDateDesc(Astro.props.projects).slice(0, 3);
---

<section class="section">
  <div class="container">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Proyectos</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-text md:text-5xl">
          Software como laboratorio personal.
        </h2>
      </div>
      <a class="text-sm font-semibold text-primary hover:underline" href="/projects">Ver proyectos →</a>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        projects.map((project) => (
          <Card href={`/projects/${project.data.slug}`}>
            <div class="flex items-center justify-between gap-3">
              <Badge tone="soft">{project.data.status}</Badge>
            </div>
            <h3 class="mt-5 text-xl font-semibold leading-snug text-text group-hover:text-primary">
              {project.data.name}
            </h3>
            <p class="mt-3 text-sm leading-6 text-muted">{project.data.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {project.data.techStack.slice(0, 4).map((tech) => <Badge>{tech}</Badge>)}
            </div>
            <p class="mt-6 text-sm font-semibold text-primary">Ver detalle →</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
