---
import Badge from "@/components/ui/Badge.astro";
import { sortByDateDesc, type Project } from "@/lib/content";

interface Props {
  projects: Project[];
}

const projects = sortByDateDesc(Astro.props.projects).slice(0, 3);
---

<section class="bg-[#f3ead8] pt-20 pb-14 md:pt-24 md:pb-16 lg:pt-32 lg:pb-20">
  <div class="container">
    <div class="grid gap-8 lg:grid-cols-[0.75fr_1fr] lg:items-end">
      <div>
        <p class="terminal-label">~/projects</p>
        <h2 class="display-type mt-4 text-5xl font-black leading-[0.94] md:text-7xl">
          Software como laboratorio personal.
        </h2>
      </div>
      <p class="max-w-2xl text-xl leading-9 text-muted">
        Proyectos que mezclan oficio, curiosidad y utilidad real. Nada de vitrinas perfectas:
        piezas vivas, hechas para aprender algo mientras sirven.
      </p>
    </div>

    <div class="terminal-shell mt-16 flex min-h-[520px] flex-col rounded-[1.75rem] md:flex-row md:rounded-[2.25rem]">
      {
        projects.map((project) => (
          <a
            class="group relative min-h-[360px] flex-1 overflow-hidden border-b border-white/10 p-7 text-white transition-[flex] duration-700 ease-out hover:flex-[2.2] md:border-b-0 md:border-r"
            href={`/projects/${project.data.slug}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {
              project.data.image && (
                <img
                  class="absolute inset-0 h-full w-full object-cover opacity-[0.38] transition-transform duration-700 ease-out group-hover:scale-105 group-hover:opacity-[0.52]"
                  src={project.data.image}
                  alt=""
                  aria-hidden="true"
                />
              )
            }
            <div class="absolute inset-0 bg-gradient-to-t from-[#081917] via-[#081917]/58 to-transparent"></div>
            <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(8,25,23,0.28),transparent_52%,rgba(181,93,56,0.16))]"></div>
            <div class="relative flex h-full min-h-[360px] flex-col justify-between">
              <div class="flex items-center justify-between gap-3">
                <Badge tone="soft">{project.data.status}</Badge>
                <span class="font-mono text-xs text-white/58">{project.data.slug}</span>
              </div>
              <div>
                <p class="terminal-command mb-4">run project --name {project.data.slug}</p>
                <h3 class="display-type text-4xl font-black leading-none md:text-5xl">
                  {project.data.name}
                </h3>
                <p class="mt-4 max-w-sm text-sm leading-6 text-white/70">{project.data.description}</p>
                <div class="mt-6 flex flex-wrap gap-2">
                  {project.data.techStack.slice(0, 4).map((tech) => <Badge>{tech}</Badge>)}
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <a class="mt-8 inline-flex rounded-xl bg-primary px-6 py-3 font-mono text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-primary-dark" href="/projects">Ver proyectos</a>
  </div>
</section>
