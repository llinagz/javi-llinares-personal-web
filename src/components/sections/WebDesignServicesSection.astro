---
import Button from "@/components/ui/Button.astro";
---

<section class="paper-band section">
  <div class="container">
    <div class="terminal-shell rounded-[1.75rem] md:rounded-[2.25rem]">
      <div class="terminal-topbar relative">
        <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>servicios/diseno-web.config</span>
      </div>

      <div class="relative grid gap-8 p-7 md:p-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
        <div>
          <p class="terminal-label">command</p>
          <p class="terminal-command mt-4">open servicio --tipo web</p>
          <h2 class="mt-5 display-type text-4xl font-black leading-[0.96] text-white md:text-6xl">
            Webs con criterio para proyectos que necesitan hacerse entender.
          </h2>
        </div>

        <div class="paper-panel rounded-2xl p-6 md:p-7">
          <p class="max-w-2xl text-lg leading-8 text-muted">
            También acompaño a profesionales, pymes y proyectos personales que necesitan una web
            clara, rápida y mantenible. Diseño, estructura, presencia digital y una forma sencilla
            de publicar sin pelearse con la tecnología.
          </p>
          <div class="mt-7 flex flex-wrap gap-4">
            <Button href="/servicios/diseno-web/">Ver servicio</Button>
            <Button href="mailto:hola@javillinares.com" variant="secondary">Cuéntame tu proyecto</Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
