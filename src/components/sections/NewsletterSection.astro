<section class="section">
  <div class="container">
    <div class="relative overflow-hidden rounded-[3rem] border border-white/30 bg-[#081917] p-8 text-white shadow-[0_36px_100px_rgba(8,25,23,0.22)] md:p-12">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(181,93,56,0.34),transparent_22rem),radial-gradient(circle_at_90%_0%,rgba(22,82,78,0.55),transparent_24rem)]"></div>
      <div class="relative grid gap-10 lg:grid-cols-[1fr_420px] lg:items-end">
        <div>
          <h2 class="display-type text-5xl font-black leading-[0.92] md:text-7xl">
            Recibir ideas sin ruido.
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-white/72">
            Sin promesas grandilocuentes: solo ideas trabajadas, proyectos en marcha y notas con calma.
          </p>
        </div>

        <form class="rounded-[1.75rem] bg-white p-3 shadow-quiet" action="#" method="post">
          <!-- TODO: Conectar proveedor de newsletter cuando se decida el flujo de publicación. -->
          <label class="sr-only" for="email">Email</label>
          <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
            <input
              class="min-h-12 rounded-2xl border border-border px-4 text-text placeholder:text-muted"
              id="email"
              name="email"
              type="email"
              placeholder="tu@email.com"
            />
            <button
              class="rounded-2xl bg-primary px-5 py-3 text-sm font-bold text-white transition hover:bg-primary-dark"
              type="submit"
            >
              Suscribirme
            </button>
          </div>
          <p class="mt-3 text-sm text-muted">
            También puedes escribirme desde <a class="font-semibold text-primary hover:underline" href="mailto:hola@javillinares.com">hola@javillinares.com</a>.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
