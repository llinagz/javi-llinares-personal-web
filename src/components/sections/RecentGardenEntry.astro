---
import Badge from "@/components/ui/Badge.astro";
import {
  excerpt,
  formatDate,
  gardenStages,
  gardenTypes,
  lastTended,
  readingTime,
  type GardenEntry
} from "@/lib/content";

interface Props {
  entry: GardenEntry;
  class?: string;
}

const { entry, class: customClass = "" } = Astro.props;
const { data } = entry;
const stage = gardenStages[data.stage];
---

<a
  class:list={[
    "paper-panel group flex min-h-[20rem] flex-col justify-between rounded-[1.75rem] p-7 transition duration-500 hover:-translate-y-1 md:p-9",
    customClass
  ]}
  href={`/jardin/${data.slug}`}
  data-reveal
  style="--reveal-index:2"
>
  <div class="flex items-center justify-between gap-3">
    <Badge tone="soft">{gardenTypes[data.type]}</Badge>
    <span class="font-mono text-xs text-muted">{stage.icon} {stage.label}</span>
  </div>

  <div class="mt-10">
    <p class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-primary">Lo último que he regado</p>
    <h2 class="display-type mt-4 text-4xl font-black leading-[0.98] text-text transition-colors group-hover:text-primary md:text-5xl">
      {data.title}
    </h2>
    <p class="editorial-serif mt-5 max-w-2xl text-lg leading-8 text-prose">{excerpt(entry)}</p>
    <p class="mt-6 font-mono text-xs text-muted">regado el {formatDate(lastTended(entry))} · {readingTime(entry.body)}</p>
  </div>
</a>
