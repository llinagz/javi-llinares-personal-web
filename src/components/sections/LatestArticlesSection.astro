---
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import { formatDate, sortByDateDesc, type BlogPost } from "@/lib/content";

interface Props {
  posts: BlogPost[];
}

const posts = sortByDateDesc(Astro.props.posts).slice(0, 3);
---

<section class="section bg-[#081917] text-white">
  <div class="container">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <h2 class="display-type max-w-4xl text-5xl font-black leading-[0.94] md:text-7xl">
        Escritura que funciona como taller abierto.
      </h2>
      <a class="rounded-full border border-white/30 px-5 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-[#081917]" href="/blog">Ver todo el blog</a>
    </div>

    <div class="mt-14 grid auto-rows-[minmax(220px,auto)] grid-flow-dense gap-4 md:grid-cols-4 md:grid-rows-2">
      {
        posts[0] && (
          <a class="group relative overflow-hidden rounded-[2rem] bg-white p-7 text-[#081917] md:col-span-2 md:row-span-2" href={`/blog/${posts[0].data.slug}`}>
            {
              posts[0].data.image && (
                <img
                  class="absolute inset-0 h-full w-full object-cover opacity-14 transition-transform duration-700 ease-out group-hover:scale-105"
                  src={posts[0].data.image}
                  alt=""
                  aria-hidden="true"
                />
              )
            }
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,253,248,0.96)_0%,rgba(255,250,239,0.92)_38%,rgba(245,240,230,0.98)_100%)]"></div>
            <div class="relative flex min-h-[420px] flex-col justify-between">
              <div class="flex items-center justify-between gap-3">
                <Badge tone="soft">{posts[0].data.category}</Badge>
                <span class="text-xs text-muted">{posts[0].data.readingTime}</span>
              </div>
              <div>
                <h3 class="display-type text-4xl font-black leading-[0.95] text-[#0f3c39] drop-shadow-[0_1px_0_rgba(255,255,255,0.55)] md:text-6xl">
                  {posts[0].data.title}
                </h3>
                <p class="mt-5 max-w-xl text-base leading-7 text-[#4f5e5c]">{posts[0].data.excerpt}</p>
                <p class="mt-7 text-sm font-bold text-primary">Leer artículo</p>
              </div>
            </div>
          </a>
        )
      }
      {
        posts.slice(1, 3).map((post) => (
          <Card href={`/blog/${post.data.slug}`} class="border-white/10 bg-[#fff7e8] text-[#081917]">
            <div class="flex items-center justify-between gap-3">
              <Badge tone="soft">{post.data.category}</Badge>
              <span class="text-xs text-muted">{post.data.readingTime}</span>
            </div>
            <h3 class="mt-5 text-xl font-semibold leading-snug text-[#081917] group-hover:text-primary">
              {post.data.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-muted">{post.data.excerpt}</p>
            <p class="mt-6 text-sm text-muted">{formatDate(post.data.date)}</p>
            <p class="mt-4 text-sm font-semibold text-primary">Leer artículo</p>
          </Card>
        ))
      }
      <a class="group overflow-hidden rounded-[2rem] border border-white/15 bg-[#e8f2f0] p-7 text-[#081917] md:col-span-2" href="/about">
        <p class="editorial-serif text-3xl leading-tight">
          La web no promete productividad infinita: busca una forma más atenta de pensar y construir.
        </p>
        <p class="mt-8 text-sm font-bold text-primary">Leer la mirada completa</p>
      </a>
    </div>
  </div>
</section>
