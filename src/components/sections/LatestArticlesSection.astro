---
import Badge from "@/components/ui/Badge.astro";
import { formatDate, sortByDateDesc, type BlogPost } from "@/lib/content";

interface Props {
  posts: BlogPost[];
}

const posts = sortByDateDesc(Astro.props.posts).slice(0, 3);
---

<section class="matrix-section section">
  <div class="container relative">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="terminal-label">./blog</p>
        <h2 class="display-type mt-4 max-w-4xl text-5xl font-black leading-[0.94] text-[#fff7e8] md:text-7xl">
          Escritura que funciona como taller abierto.
        </h2>
      </div>
      <a class="rounded-xl border border-white/20 px-5 py-3 font-mono text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-white hover:text-[#081917]" href="/blog">Ver todo el blog</a>
    </div>

    <div class="mt-14 grid auto-rows-[minmax(220px,auto)] grid-flow-dense gap-4 md:grid-cols-4 md:grid-rows-2">
      {
        posts[0] && (
          <a class="group terminal-shell rounded-[1.5rem] p-0 md:col-span-2 md:row-span-2" href={`/blog/${posts[0].data.slug}`}>
            {
              posts[0].data.image && (
                <img
                  class="absolute inset-0 h-full w-full object-cover opacity-[0.18] grayscale transition-transform duration-700 ease-out group-hover:scale-105"
                  src={posts[0].data.image}
                  alt=""
                  aria-hidden="true"
                />
              )
            }
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,19,17,0.94)_0%,rgba(6,19,17,0.9)_42%,rgba(6,19,17,0.98)_100%)]"></div>
            <div class="terminal-topbar relative">
              <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
              <span>{posts[0].data.slug}.md</span>
            </div>
            <div class="relative flex min-h-[420px] flex-col justify-between p-7">
              <div class="flex items-center justify-between gap-3">
                <Badge tone="soft">{posts[0].data.category}</Badge>
                <span class="font-mono text-xs text-white/58">{posts[0].data.readingTime}</span>
              </div>
              <div>
                <p class="terminal-command mb-4">read featured</p>
                <h3 class="display-type text-4xl font-black leading-[0.95] text-[#fff7e8] md:text-6xl">
                  {posts[0].data.title}
                </h3>
                <p class="mt-5 max-w-xl text-base leading-7 text-white/68">{posts[0].data.excerpt}</p>
                <p class="mt-7 font-mono text-sm font-bold text-[#d08762]">Leer artículo</p>
              </div>
            </div>
          </a>
        )
      }
      {
        posts.slice(1, 3).map((post) => (
          <a class="paper-panel group block h-full overflow-hidden rounded-[1.5rem] p-6 transition duration-500 hover:-translate-y-1 hover:border-[#d08762]/40" href={`/blog/${post.data.slug}`}>
            <div class="flex items-center justify-between gap-3">
              <Badge tone="soft">{post.data.category}</Badge>
              <span class="font-mono text-xs text-muted">{post.data.readingTime}</span>
            </div>
            <p class="mt-5 font-mono text-sm leading-6 text-muted">$ open {post.data.slug}.md</p>
            <h3 class="mt-4 text-xl font-semibold leading-snug text-[#081917] group-hover:text-primary">
              {post.data.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-muted">{post.data.excerpt}</p>
            <p class="mt-6 font-mono text-xs text-muted">{formatDate(post.data.date)}</p>
            <p class="mt-4 text-sm font-semibold text-primary">Leer artículo</p>
          </a>
        ))
      }
      <a class="paper-panel group overflow-hidden rounded-[1.5rem] bg-[#e8f2f0] p-7 transition duration-500 hover:-translate-y-1 md:col-span-2" href="/about">
        <p class="font-mono text-sm leading-6 text-muted">$ cat about/mirada.txt</p>
        <p class="editorial-serif text-3xl leading-tight">
          La web no promete productividad infinita: busca una forma más atenta de pensar y construir.
        </p>
        <p class="mt-8 text-sm font-bold text-primary">Leer la mirada completa</p>
      </a>
    </div>
  </div>
</section>
