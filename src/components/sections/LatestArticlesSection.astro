---
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import { formatDate, sortByDateDesc, type BlogPost } from "@/lib/content";

interface Props {
  posts: BlogPost[];
}

const posts = sortByDateDesc(Astro.props.posts).slice(0, 3);
---

<section class="section bg-surface/55">
  <div class="container">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Últimos artículos</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-text md:text-5xl">
          Escritura para pensar en público.
        </h2>
      </div>
      <a class="text-sm font-semibold text-primary hover:underline" href="/blog">Ver todo el blog →</a>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        posts.map((post) => (
          <Card href={`/blog/${post.data.slug}`}>
            <div class="flex items-center justify-between gap-3">
              <Badge tone="soft">{post.data.category}</Badge>
              <span class="text-xs text-muted">{post.data.readingTime}</span>
            </div>
            <h3 class="mt-5 text-xl font-semibold leading-snug text-text group-hover:text-primary">
              {post.data.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-muted">{post.data.excerpt}</p>
            <p class="mt-6 text-sm text-muted">{formatDate(post.data.date)}</p>
            <p class="mt-4 text-sm font-semibold text-primary">Leer artículo →</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
