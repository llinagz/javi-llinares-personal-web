---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: customClass = "" } = Astro.props;
const className =
  `group block h-full overflow-hidden rounded-3xl border border-border bg-surface p-6 transition duration-500 hover:-translate-y-1 hover:border-primary/40 hover:shadow-quiet ${customClass}`;
---

{
  href ? (
    <a class={className} href={href}>
      <slot />
    </a>
  ) : (
    <article class={className}>
      <slot />
    </article>
  )
}
