---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: customClass = "" } = Astro.props;
const className =
  `paper-panel group block h-full overflow-hidden rounded-[1.5rem] p-6 transition duration-500 hover:-translate-y-1 hover:border-primary/35 ${customClass}`;
---

{
  href ? (
    <a class={className} href={href}>
      <slot />
    </a>
  ) : (
    <article class={className}>
      <slot />
    </article>
  )
}
