---
interface Props {
  tone?: "default" | "soft";
}

const { tone = "default" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold tracking-[0.02em]",
    tone === "soft"
      ? "border-primary/15 bg-primary-soft text-primary-dark"
      : "border-border bg-surface text-muted"
  ]}
>
  <slot />
</span>
