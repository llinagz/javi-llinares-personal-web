---
import { hasPublishedPhotos } from "@/lib/content";

const navItems = [
  { href: "/jardin", label: "/jardín" },
  ...((await hasPublishedPhotos()) ? [{ href: "/carrete", label: "/carrete" }] : []),
  { href: "/temas", label: "/temas" },
  { href: "/projects", label: "/proyectos" },
  { href: "/servicios/diseno-web/", label: "/diseño-web" },
  { href: "/about", label: "/sobre-mí" }
];

const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href.replace(/\/$/, "")}/`);
---

<header class="site-header fixed left-0 right-0 top-4 z-50">
  <div class="container flex min-h-16 items-center justify-between gap-4 rounded-full border border-paper/18 bg-terminal/[0.76] px-4 shadow-[0_18px_70px_rgba(3,9,9,0.28)] backdrop-blur-xl md:px-6">
    <a class="editorial-serif text-2xl text-paper" href="/">
      Javi Llinares
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a
            class:list={[
              "rounded-lg px-3 py-1.5 font-mono text-sm transition hover:text-paper",
              isActive(item.href) ? "bg-paper/[0.08] text-paper" : "text-terminal-text/[0.72]"
            ]}
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-paper/20 text-paper md:hidden"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-button
    >
      <span class="sr-only">Abrir menú</span>
      <span aria-hidden="true" class="text-xl leading-none">☰</span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="container mt-2 hidden rounded-3xl border border-paper/16 bg-terminal/[0.92] p-4 shadow-[0_18px_70px_rgba(3,9,9,0.28)] backdrop-blur-xl md:hidden"
    aria-label="Navegación móvil"
    data-mobile-menu
  >
    <div class="grid gap-2">
      {
        navItems.map((item) => (
          <a
            class:list={[
              "rounded-2xl px-3 py-2 font-mono text-sm hover:bg-paper/[0.08] hover:text-paper",
              isActive(item.href) ? "bg-paper/[0.08] text-paper" : "text-terminal-text/[0.82]"
            ]}
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-mobile-menu]");

  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("hidden", isOpen);
  });
</script>
