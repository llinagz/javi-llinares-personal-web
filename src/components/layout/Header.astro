---
const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Proyectos" },
  { href: "/about", label: "Sobre mí" }
];
---

<header class="fixed left-0 right-0 top-4 z-50">
  <div class="container flex min-h-16 items-center justify-between gap-4 rounded-full border border-white/40 bg-[#fff7e8]/82 px-4 shadow-[0_18px_70px_rgba(8,25,23,0.12)] backdrop-blur-xl md:px-6">
    <a class="display-type text-xl font-black tracking-[-0.05em] text-text" href="/">
      Javi Llinares
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a class="text-sm font-semibold text-muted transition hover:text-primary" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a
        class="rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-white transition hover:bg-primary-dark"
        href="/blog"
      >
        Leer artículos
      </a>
    </nav>

    <button
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-primary/20 text-primary md:hidden"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-button
    >
      <span class="sr-only">Abrir menú</span>
      <span aria-hidden="true" class="text-xl leading-none">☰</span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="container mt-2 hidden rounded-3xl border border-white/40 bg-[#fff7e8]/92 p-4 shadow-[0_18px_70px_rgba(8,25,23,0.12)] backdrop-blur-xl md:hidden"
    aria-label="Navegación móvil"
    data-mobile-menu
  >
    <div class="grid gap-2">
      {
        navItems.map((item) => (
          <a class="rounded-2xl px-3 py-2 text-sm font-semibold text-muted hover:bg-primary-soft hover:text-primary" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-mobile-menu]");

  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("hidden", isOpen);
  });
</script>
