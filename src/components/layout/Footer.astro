---
import { hasPublishedPhotos } from "@/lib/content";

const links = [
  { href: "/jardin", label: "Jardín" },
  ...((await hasPublishedPhotos()) ? [{ href: "/carrete", label: "Carrete" }] : []),
  { href: "/projects", label: "Proyectos" },
  { href: "/servicios/diseno-web/", label: "Diseño web" },
  { href: "/about", label: "Sobre mí" },
  { href: "/rss.xml", label: "RSS" },
  { href: "https://github.com/llinagz", label: "GitHub", target: "_blank", rel: "noopener" },
  { href: "https://www.linkedin.com/in/javierllinaresbarral", label: "LinkedIn", target: "_blank", rel: "noopener" }
];
---

<footer class="matrix-section border-t border-paper/10">
  <div class="container relative grid gap-8 py-12 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="terminal-label">~/footer</p>
      <p class="editorial-serif mt-3 text-2xl font-semibold text-paper">Javi Llinares</p>
      <p class="mt-3 max-w-xl text-sm leading-6 text-terminal-text/[0.68]">
        Un jardín personal sobre código, pensamiento y la vida que queda entre medias.
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-terminal-text/[0.66]" aria-label="Enlaces de pie de página">
      {
        links.map((link) => (
          <a class="transition hover:text-paper" href={link.href} target={link.target} rel={link.rel}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <p class="font-mono text-xs text-terminal-text/[0.52] md:col-span-2">
      © {new Date().getFullYear()} Javi Llinares. Hecho con calma desde Galicia, Astro y muchas notas.
    </p>
  </div>
</footer>
